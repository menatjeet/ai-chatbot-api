# Application Settings
APP_NAME="AI Chatbot API"
APP_VERSION="1.0.0"
DEBUG=False

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection URL (e.g. Supabase, Render, Neon, or local Postgres)
# Example: postgresql+psycopg://user:password@localhost:5432/chatbot_db
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chatbot_db

# JWT Authentication Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=generate_a_secure_random_hex_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30